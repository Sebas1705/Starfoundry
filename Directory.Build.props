<Project>
  <!-- The VERSION file at the repository root is the single source of the product version (docs/release.md).
       It feeds the assembly version, which the game shows through Starfoundry.Ui.BuildInfo. -->
  <PropertyGroup>
    <StarfoundryVersion Condition="Exists('$(MSBuildThisFileDirectory)VERSION')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</StarfoundryVersion>
    <Version Condition="'$(StarfoundryVersion)' != ''">$(StarfoundryVersion)</Version>
  </PropertyGroup>
</Project>
